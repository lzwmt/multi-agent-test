{
  "basic_procedure": {
    "title": "占卜的基本程序",
    "steps": [
      "问卜者洗牌（部分牌倒立），交给你正面朝下",
      "检视最底牌代表问卜者最想问的话题",
      "问卜者发牌分三叠",
      "三叠牌叠在一起",
      "摊成扇形，闭眼用非写字手选牌",
      "选好后侧翻（不翻转），按牌形放位置"
    ]
  },
  "reversed_cards": {
    "title": "倒立牌的解读",
    "rules": [
      "倒立=尚未精通前一张正立牌的课题",
      "王牌倒立=尚未精通该牌组正立十的课题",
      "宫廷牌因非顺序排列倒立意义不同"
    ]
  },
  "asking_questions": {
    "title": "如何问问题",
    "rules": [
      "问题要一字一句说清楚",
      "避免过于情绪化的问题",
      "问我该怎么做而非是否会破裂",
      "每次只问两三个问题"
    ]
  },
